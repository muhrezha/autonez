# ============================================================
# AUTONEZ — Environment Variables Template
# Copy file ini ke .env.local dan isi nilainya
# JANGAN commit .env.local ke git
# ============================================================

# URL publik aplikasi (sesuaikan per environment)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nama environment: development | production
NEXT_PUBLIC_APP_ENV=development

# Kredensial admin CMS (server-side only, TIDAK perlu NEXT_PUBLIC_)
ADMIN_EMAIL=admin@autonez.com
ADMIN_PASSWORD=ganti_dengan_password_aman

# Maintenance mode: "true" = tampilkan halaman maintenance, "false" = normal
MAINTENANCE_MODE=true
